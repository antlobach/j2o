{:paths ["src" "resources" "experiments"]
 :jolt/min-version "0.8.27"
 :deps {jolt-lang/jolt-crypto {:git/url "https://github.com/jolt-lang/crypto"
                               :git/tag "v0.2.1" :git/sha "b9c64853243750ee65815144adfb69cc7ccacfe8"}
        jolt-lang/multipart {:git/url "https://github.com/jolt-lang/multipart"
                             :git/tag "v0.1.3" :git/sha "4c9326ab7a88d4551f20c77b4135bfde4d6308a5"}}
 :jolt/native [{:name "z" :optional true
                :darwin ["libz.dylib" "/usr/lib/libz.dylib"]
                :linux ["libz.so.1" "libz.so"] :windows ["zlib1.dll" "zlib.dll"]}
               {:name "zstd" :optional true
                :darwin ["libzstd.1.dylib" "/opt/homebrew/lib/libzstd.1.dylib" "/usr/local/lib/libzstd.1.dylib"]
                :linux ["libzstd.so.1" "libzstd.so"] :windows ["libzstd.dll" "zstd.dll"]}]
 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {jolt-lang/http-client
                               {:git/url "https://github.com/jolt-lang/http-client"
                                :git/tag "v0.1.4" :git/sha "e0c935e99b92db8e0934867f1cebcf11b3f837a5"}}
                  :main-opts ["-m" "j2o.test-runner"]}
           :ci {:extra-paths ["test"] :main-opts ["-m" "j2o.test-runner"]}}}
